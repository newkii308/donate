APP_NAME="TIPLAO DONATE"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-domain.com

APP_TIMEZONE=Asia/Vientiane
APP_LOCALE=lo
APP_FALLBACK_LOCALE=lo
APP_FAKER_LOCALE=en_US

# NEWLAB Donation Platform
NEWLAB_DEFAULT_CURRENCY=LAK
NEWLAB_OVERLAY_POLL_SECONDS=3
NEWLAB_TTS_PROVIDER=browser
NEWLAB_TTS_CACHE_DAYS=7
NEWLAB_TTS_LANGUAGE=lo-LA
NEWLAB_TRUEWALLET_ENABLED=false

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# Production database (MySQL / MariaDB on DirectAdmin shared hosting)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=newlab
DB_USERNAME=newlab
DB_PASSWORD=

# Shared hosting friendly drivers (no Redis required)
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@your-domain.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
