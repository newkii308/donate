APP_NAME="DONATE LIVE"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-domain.com

APP_LOCALE=th
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# NEWLAB Donation Platform
NEWLAB_DEFAULT_CURRENCY=THB
NEWLAB_OVERLAY_POLL_SECONDS=3
NEWLAB_TTS_PROVIDER=browser
NEWLAB_TTS_CACHE_DAYS=7
NEWLAB_TRUEWALLET_ENABLED=true
NEWLAB_TRUEWALLET_MIN=1

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# ตั้งค่าฐานข้อมูล MySQL ของโฮส (จาก DirectAdmin > MySQL Management)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=changeme_donate
DB_USERNAME=changeme_donate
DB_PASSWORD=changeme

# ใช้ driver ที่ไม่ต้องพึ่ง Redis (เหมาะกับ shared hosting)
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@your-domain.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
